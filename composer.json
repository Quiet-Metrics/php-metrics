{
    "name": "quiet-metrics/php-metrics",
    "description": "Package cœur Quiet Metrics (PHP pur) : mesure d'audience sans cookies, 100 % côté serveur, imblocable par les adblockers. Fondation des ponts Laravel et Symfony.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "analytics",
        "privacy",
        "rgpd",
        "sans-cookies",
        "server-side"
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "suggest": {
        "ext-curl": "Transport de repli si les sockets sortants (fsockopen) sont désactivés"
    },
    "autoload": {
        "psr-4": {
            "QuietMetrics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuietMetrics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
